# ---------------------------------------------------------------------------
# Browser environment. Copy to `.env.local` and fill in.
#
# These two values are baked into the public bundle by Vite. Only the
# *publishable* key belongs here — it is safe to ship to browsers.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# For local work this is http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Supabase publishable key, e.g. sb_publishable_...
# NEVER put a service-role / secret key in a VITE_ variable. `src/lib/supabase.ts`
# asserts at module load that no secret credential is present and throws if one is.
VITE_SUPABASE_PUBLISHABLE_KEY=


# ---------------------------------------------------------------------------
# NOT IN THIS FILE — these live in Supabase, never in a file in the repo.
#
# The browser cannot read them, and nothing in `src/` should ever reference them.
# Set them per-environment instead:
#
#   Remote  : Supabase dashboard -> Edge Functions -> Secrets
#   Local   : `supabase/.env.local` (gitignored), consumed by `npm run db:functions`
#   CI      : not set at all — the CI job never deploys Edge Functions.
#
#   SUPABASE_URL                  # injected automatically by the Edge Function runtime. Do not set it.
#   SUPABASE_SERVICE_ROLE_KEY     # server-side only. Never a VITE_ variable. Never in the bundle.
#   MAILGUN_API_KEY              # Mailgun -> Sending -> domain settings. Starts with "key-".
#   MAILGUN_DOMAIN               # bare hostname, no scheme, no trailing slash.
#   MAILGUN_FROM                 # "Kanso <orders@yourdomain.com>"
#   APP_URL                      # public origin, e.g. https://kanso.netlify.app
# ---------------------------------------------------------------------------