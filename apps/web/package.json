{
  "name": "kanso",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:classes": "node scripts/audit-classes.mjs",
    "ci:check": "npm run typecheck && npm run check && npm run test:unit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:func": "node scripts/functional-env.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:functions": "supabase functions serve create-order --env-file supabase/.env.local"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.6",
    "@fontsource/archivo-black": "^5.2.6",
    "@supabase/supabase-js": "^2.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
